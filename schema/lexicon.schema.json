{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jmilbery/boston-translatah/schema/lexicon.schema.json",
  "title": "Lexicon entry",
  "description": "One Boston slang term. One term per file.",
  "type": "object",
  "required": [
    "term",
    "means",
    "region",
    "register",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "term": {
      "type": "string",
      "minLength": 1,
      "description": "The Boston word or phrase."
    },
    "means": {
      "type": "string",
      "minLength": 1,
      "description": "Plain-English equivalent."
    },
    "also": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternate spellings."
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Region slug, e.g. boston, brockton-508, stl-314. Must be registered in data/regions.yml — the validator checks it, and that the file sits in the matching folder."
    },
    "register": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "1 = everyone knows it (wicked); 3 = deep local (spuckie)."
    },
    "part_of_speech": {
      "type": "string",
      "enum": [
        "noun",
        "verb",
        "adjective",
        "adverb",
        "interjection",
        "phrase"
      ]
    },
    "example": {
      "type": "string",
      "description": "One sentence using it naturally."
    },
    "notes": {
      "type": "string"
    },
    "offensive": {
      "type": "boolean",
      "description": "If true, stored for reverse lookup ONLY; never emitted. Maintainers only."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "REQUIRED. At least one. No source, no merge.",
      "items": {
        "type": "object",
        "required": [
          "type",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "url",
              "vouch",
              "book"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scene": {
      "type": "string",
      "minLength": 1,
      "description": "The world this word lives in — hip-hop, transit, food, sports. A free string on purpose: no enum, so nobody has to win an argument about the taxonomy before adding a word."
    },
    "attribution": {
      "type": "object",
      "required": [
        "who"
      ],
      "additionalProperties": false,
      "description": "Who put this term into wide circulation, where credit is owed. Not the same as sources: — that's where WE read it, this is who said it first.",
      "properties": {
        "who": {
          "type": "string",
          "minLength": 1,
          "description": "Person, group, or outlet."
        },
        "work": {
          "type": "string",
          "minLength": 1,
          "description": "The record, film, column or show it rode in on."
        },
        "year": {
          "type": "integer",
          "minimum": 1600,
          "maximum": 2100
        }
      }
    }
  }
}
